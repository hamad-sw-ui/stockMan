# Copier vers .env et adapter les valeurs

# PostgreSQL (URI complète)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockman

# API
PORT=5000
NODE_ENV=development

# JWT — utiliser des secrets longs et uniques en production
JWT_SECRET=changez-moi-access-token
REFRESH_SECRET=changez-moi-refresh-token

# Origines CORS autorisées (virgule si plusieurs). Ex. dev Vite + LAN :
# CORS_ORIGIN=http://localhost:5173,http://192.168.1.10:5173
CORS_ORIGIN=http://localhost:5173
