# ---- Base de données --------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockman

# ---- Serveur ----------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Origines autorisées (séparateur virgule). En prod : le domaine du front.
CORS_ORIGIN=http://localhost:5173
# Laisser 1 derrière nginx/traefik (X-Forwarded-For)
TRUST_PROXY=1

# ---- Sécurité (OBLIGATOIRE, aucun secret par défaut — le boot échoue sinon) -
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REFRESH_SECRET=
BCRYPT_ROUNDS=10

# ---- Métier -----------------------------------------------------------------
# Jours de grâce après expiration de licence (lecture seule ensuite)
LICENSE_GRACE_DAYS=3
# Âge max d'une vente synchronisée hors-ligne (heures)
MAX_SYNC_AGE_HOURS=48
# Activer les tâches planifiées (false en test)
ENABLE_SCHEDULER=true

# ---- Notifications ----------------------------------------------------------
# mock (console) | live (providers réels, clés ci-dessous ou en tenant_configs)
NOTIF_DRIVER=mock
# Africa's Talking
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=
# WhatsApp Cloud API (Meta)
WA_TOKEN=
WA_PHONE_ID=

# ---- Migrations -------------------------------------------------------------
# Par défaut : détection automatique (database/migrations à la racine du repo)
# MIGRATIONS_DIR=/chemin/absolu/database/migrations
